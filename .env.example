# Copy this file to .env.local and fill in your own values. Never commit .env.local.
# Both values are public by design. Data is protected by Row Level Security, not by hiding them.
# Find them in the Supabase dashboard: Project Settings > API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# NEVER put the service_role key in this file or anywhere in this app.

# Map tiles. Leave empty in development to use public OpenStreetMap (not allowed for production traffic).
# For production use a provider with a key, for example MapTiler:
# VITE_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
# VITE_MAP_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=

# Place search by typing. "photon" (default) is a free shared server, fine for development.
# For launch use Geoapify: set VITE_GEOCODE_PROVIDER=geoapify and VITE_GEOAPIFY_KEY=your key.
VITE_GEOCODE_PROVIDER=
VITE_GEOAPIFY_KEY=

# Web Push (public key only; generate with: npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=
